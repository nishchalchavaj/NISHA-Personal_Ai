# Copy to .env. The installed application is local-only.
# setup.ps1 generates a random gateway key; do not publish that file.
NISHA_GATEWAY_KEY=
NISHA_API_KEY=
ODYSSEUS_URL=http://127.0.0.1:7000
ODYSSEUS_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
# Future optional task worker: enable external_tasks_enabled in config first.
# NISHA_TASK_MODEL=provider/model
# Add its provider key only when explicitly enabling that worker.

